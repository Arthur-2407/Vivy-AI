# ── Virtual Environments & Python Cache ──
__pycache__/
*.py[cod]
*$py.class
venv/
venv_avatar/
venv_rvc/
.pytest_cache/
.vscode/
.vs/

# ── AI Model Weights & Checkpoints (Prevent GitHub >100MB errors) ──
*.gguf
*.pt
*.pth
*.bin
*.onnx
models/*.gguf
models/*.bin
models/*.pt
rvc_cpu/**/*.pth
rvc_cpu/**/*.pt

# ── Runtime State, Audio Recordings & Shared IPC Buffers ──
shared/
recordings/
transcripts/
vivy_recordings/
scratch/
*.tmp
*.lock
*.log
*.wav
*.mp3
*.flac
*.m4a
*.flag
vivy_startup*.log
runtime_animator_diag.txt
mock_unity*.log

# ── OS Generated Files ──
Thirteenth
Thumbs.db
.DS_Store

