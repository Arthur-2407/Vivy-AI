# Version control
.git
.gitignore
.github

# Python virtual environments & bytecode
venv/
venv_avatar/
venv_rvc/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Unity / Mate-Engine caches (large binary assets not needed in core container)
Mate-Engine/Library/
Mate-Engine/Temp/
Mate-Engine/Obj/
Mate-Engine/Build/
Mate-Engine/Builds/
Mate-Engine/Logs/
Mate-Engine/MemoryCaptures/
Mate-Engine/UserSettings/
Mate-Engine/*.csproj
Mate-Engine/*.sln

# Android Node build artifacts
android_node/.gradle/
android_node/.idea/
android_node/app/build/
android_node/build/
android_node/local.properties

# Logs and scratch files
logs/
*.log
scratch/
backup/
Reports/
dist/

# Large test audio outputs
recordings/
vivy_recordings/
transcripts/
*.wav

# HuggingFace model cache (25+ GB locally — production containers mount or download models)
# These dirs are gitignored but not dockerignored; COPY . /app/ would include them.
model_cache/
tmp_spkrec/

# RVC training checkpoints and large voice model artifacts (mounted via volume in production)
rvc_cpu/logs/

# Large scratch and development files not needed in container
*.txt
*.log
readme_unstaged_diff.txt
unstaged_diff.txt
staged_diff.txt
git_diff.txt
unity_direct_start.log
