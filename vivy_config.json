{
  "_comment": "Vivy AI — Central Configuration File. Edit this file to change any system behaviour.",
  "_comment2": "All paths support both absolute and relative-to-project-root paths.",

  "apis": {
    "duckduckgo_lite": "https://lite.duckduckgo.com/lite/",
    "duckduckgo_html": "https://html.duckduckgo.com/html/?q=",
    "captive_portal": "http://detectportal.firefox.com/success.txt",
    "gemini_base": "https://generativelanguage.googleapis.com/v1beta/models/",
    "openai_base": "https://api.openai.com/v1/chat/completions"
  },

  "models": {
    "llm":       "models/Qwen3-8B-Q4_K_M.gguf",
    "whisper":   "models/ggml-small.bin",
    "tts":       "tts_models/en/ljspeech/tacotron2-DDC",
    "emotion":   "j-hartmann/emotion-english-distilroberta-base",
    "vision":    "models/moondream-vision.gguf",
    "embedding": "BAAI/bge-small-en-v1.5",
    "face_detection": "models/yolov11/yolo11n-face.pt",
    "lip_sync_musetalk": "models/musetalk/musetalk.pt",
    "lip_sync_wav2lip": "models/wav2lip/wav2lip.pth"
  },

  "screen_perception": {
    "enabled":                      true,
    "fps":                          30,
    "staleness_seconds":            60,
    "ocr_enabled":                  true,
    "vision_model_enabled":         true,
    "capture_resolution_max_width": 1920,
    "ocr_char_limit":               10000,
    "adaptive_sampling_enabled":    true,
    "min_sampling_delay_ms":        33,
    "max_sampling_delay_ms":        2000,
    "static_threshold":             0.02,
    "tesseract_paths": [
      "C:\\Program Files\\Tesseract-OCR\\tesseract.exe",
      "C:\\Program Files (x86)\\Tesseract-OCR\\tesseract.exe",
      "C:\\Users\\SATYAJEET\\AppData\\Local\\Programs\\Tesseract-OCR\\tesseract.exe"
    ]
  },

  "audio_perception": {
    "enabled":                   true,
    "system_audio_capture":      true,
    "ambient_analysis_interval": 2.0,
    "speech_ambient_separation": true,
    "min_audio_level_db":        -40.0
  },

  "multimodal": {
    "event_memory_minutes":    10,
    "event_memory_max_events": 200,
    "context_token_budget":    800,
    "fusion_interval_seconds": 1.0,
    "summary_trigger_count":   50
  },

  "proactivity": {
    "enabled":              false,
    "threshold":            0.8,
    "min_interval_seconds": 30,
    "max_per_session":      20
  },

  "pipeline": {
    "poll_interval_seconds":    0.25,
    "mic_sample_rate":          16000,
    "mic_frame_ms":             30,
    "mic_base_silence_timeout": 1.2,
    "mic_max_silence_limit":    3.0,
    "whisper_threads":          2,
    "llm_n_ctx":                8192,
    "llm_n_threads":            8,
    "llm_n_batch":              512,
    "llm_n_ubatch":             512,
    "llm_n_gpu_layers":         -1,
    "llm_temperature":          0.75,
    "llm_repeat_penalty":       1.15
  },

  "server": {
    "host":        "127.0.0.1",
    "web_port":    8080,
    "ws_port":     8765,
    "ws_reconnect_delay": 3.0
  },

  "paths": {
    "shared_dir":        "shared",
    "recordings_dir":    "recordings",
    "transcripts_dir":   "transcripts",
    "uploads_dir":       "shared/uploads",
    "audio_static_dir":  "static/audio",
    "memory_file":       "vivy_memory.json",
    "history_file":      "vivy_history.json",
    "rvc_dir":           "rvc_cpu"
  },

  "internet_intelligence": {
    "enabled":                      true,
    "primary_provider":             "duckduckgo",
    "fallback_providers":            ["wikipedia"],
    "network_check_interval_seconds": 15.0,
    "ping_target":                  "1.1.1.1",
    "timeout_seconds":              5.0,
    "cache_ttl_seconds":            86400,
    "max_cache_entries":            1000,
    "safesearch":                   "moderate",
    "auto_knowledge_update":        true,
    "user_agent":                   "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.6261.112 Safari/537.36"
  },

  "session_isolation": {
    "enabled":                      true,
    "clear_display_history_on_start": true,
    "archive_sessions":            true,
    "session_timeout_seconds":      1800
  },

  "memory_architecture": {
    "enabled":                      true,
    "intent_driven_retrieval":     true,
    "max_retrieved_memories":      3,
    "consolidation_interval_turns": 5,
    "memory_file":                 "vivy_memory.json"
  }
}
