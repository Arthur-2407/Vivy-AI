{
  "_comment": "Vivy AI — Central Configuration File. Edit this file to change any system behaviour.",
  "_comment2": "All paths support both absolute and relative-to-project-root paths.",

  "apis": {
    "duckduckgo_lite": "https://lite.duckduckgo.com/lite/",
    "duckduckgo_html": "https://html.duckduckgo.com/html/?q=",
    "captive_portal": "http://detectportal.firefox.com/success.txt",
    "gemini_base": "https://generativelanguage.googleapis.com/v1beta/models/",
    "openai_base": "https://api.openai.com/v1/chat/completions"
  },

  "models": {
    "llm":       "models/Qwen3-8B-Q4_K_M.gguf",
    "whisper":   "models/ggml-small.bin",
    "tts":       "tts_models/en/ljspeech/tacotron2-DDC",
    "emotion":   "j-hartmann/emotion-english-distilroberta-base",
    "vision":    "models/moondream-vision.gguf",
    "embedding": "BAAI/bge-small-en-v1.5",
    "face_detection": "models/yolov11/yolo11n-face.pt",
    "lip_sync_musetalk": "models/musetalk/musetalk.pt",
    "lip_sync_wav2lip": "models/wav2lip/wav2lip.pth"
  },

  "screen_perception": {
    "enabled":                      true,
    "fps":                          30,
    "staleness_seconds":            60,
    "ocr_enabled":                  true,
    "vision_model_enabled":         true,
    "capture_resolution_max_width": 1920,
    "ocr_char_limit":               10000,
    "adaptive_sampling_enabled":    true,
    "min_sampling_delay_ms":        33,
    "max_sampling_delay_ms":        2000,
    "static_threshold":             0.02,
    "tesseract_paths": [
      "C:\\Program Files\\Tesseract-OCR\\tesseract.exe",
      "C:\\Program Files (x86)\\Tesseract-OCR\\tesseract.exe",
      "C:\\Users\\SATYAJEET\\AppData\\Local\\Programs\\Tesseract-OCR\\tesseract.exe"
    ]
  },

  "audio_perception": {
    "enabled":                   true,
    "system_audio_capture":      true,
    "ambient_analysis_interval": 2.0,
    "speech_ambient_separation": true,
    "min_audio_level_db":        -40.0
  },

  "multimodal": {
    "event_memory_minutes":    10,
    "event_memory_max_events": 200,
    "context_token_budget":    800,
    "fusion_interval_seconds": 1.0,
    "summary_trigger_count":   50
  },

  "proactivity": {
    "enabled":              false,
    "threshold":            0.8,
    "min_interval_seconds": 30,
    "max_per_session":      20
  },

  "pipeline": {
    "auto_listen":              false,
    "poll_interval_seconds":    0.25,
    "mic_sample_rate":          16000,
    "mic_frame_ms":             30,
    "mic_base_silence_timeout": 1.2,
    "mic_max_silence_limit":    3.0,
    "whisper_threads":          2,
    "llm_n_ctx":                8192,
    "llm_n_threads":            8,
    "llm_n_batch":              512,
    "llm_n_ubatch":             512,
    "llm_n_gpu_layers":         -1,
    "llm_temperature":          0.75,
    "llm_repeat_penalty":       1.15
  },

  "server": {
    "host":        "127.0.0.1",
    "web_port":    8080,
    "ws_port":     8765,
    "ws_reconnect_delay": 3.0
  },

  "paths": {
    "shared_dir":        "shared",
    "recordings_dir":    "recordings",
    "transcripts_dir":   "transcripts",
    "uploads_dir":       "shared/uploads",
    "audio_static_dir":  "static/audio",
    "memory_file":       "vivy_memory.json",
    "history_file":      "vivy_history.json",
    "rvc_dir":           "rvc_cpu"
  },

  "internet_intelligence": {
    "enabled":                      true,
    "primary_provider":             "duckduckgo",
    "fallback_providers":            ["wikipedia"],
    "network_check_interval_seconds": 15.0,
    "ping_target":                  "1.1.1.1",
    "timeout_seconds":              5.0,
    "cache_ttl_seconds":            86400,
    "max_cache_entries":            1000,
    "safesearch":                   "moderate",
    "auto_knowledge_update":        true,
    "user_agent":                   "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.6261.112 Safari/537.36"
  },

  "session_isolation": {
    "enabled":                      true,
    "clear_display_history_on_start": true,
    "archive_sessions":            true,
    "session_timeout_seconds":      1800
  },

  "memory_architecture": {
    "enabled":                      true,
    "intent_driven_retrieval":     true,
    "max_retrieved_memories":      3,
    "consolidation_interval_turns": 5,
    "memory_file":                 "vivy_memory.json"
  },

  "multilingual_engine": {
    "enabled": true,
    "default_language": "en",
    "auto_detect_from_whisper": true,
    "auto_detect_from_text": true,
    "cross_lingual_memory": true,
    "preserve_rvc_voice_identity": true,
    "supported_native_llm_languages": ["en", "hi", "ja", "zh", "es", "fr", "de", "ru", "or", "bn", "ko"],
    "regional_dialect_mapping": {
      "or": {"name": "Odia", "script_range_start": 2816, "script_range_end": 2943, "script_ranges": [[2816, 2943]], "use_localized_tts": true, "honorific": "ତୁମେ"},
      "bn": {"name": "Bengali", "script_range_start": 2432, "script_range_end": 2559, "script_ranges": [[2432, 2559]], "use_localized_tts": true, "honorific": "ତୁମେ"},
      "hi": {"name": "Hindi", "script_range_start": 2304, "script_range_end": 2431, "script_ranges": [[2304, 2431]], "use_localized_tts": false, "honorific": "आप"},
      "ja": {"name": "Japanese", "script_range_start": 12352, "script_range_end": 12799, "script_ranges": [[12288, 12799], [19968, 40959]], "use_localized_tts": false, "honorific": "さん"},
      "zh": {"name": "Chinese", "script_range_start": 19968, "script_range_end": 40959, "script_ranges": [[19968, 40959], [13312, 19903]], "use_localized_tts": false, "honorific": "您"},
      "ru": {"name": "Russian", "script_range_start": 1024, "script_range_end": 1279, "script_ranges": [[1024, 1279]], "use_localized_tts": false, "honorific": ""},
      "ko": {"name": "Korean", "script_range_start": 44032, "script_range_end": 55215, "script_ranges": [[44032, 55215], [12592, 12687]], "use_localized_tts": false, "honorific": "님"},
      "fr": {"name": "French", "script_range_start": -1, "script_range_end": -1, "script_ranges": [], "use_localized_tts": false, "honorific": ""},
      "es": {"name": "Spanish", "script_range_start": -1, "script_range_end": -1, "script_ranges": [], "use_localized_tts": false, "honorific": ""},
      "de": {"name": "German", "script_range_start": -1, "script_range_end": -1, "script_ranges": [], "use_localized_tts": false, "honorific": ""}
    },
    "linguistic_fingerprints": {
      "fr": ["qu'est-ce", "qu'est", "que", "qui", "aimes", "manger", "peux", "dire", "comment", "faire", "une", "les", "ingrédients", "nécessaires", "pourquoi", "quand", "oui", "merci", "bonjour", "salut", "vous", "nous", "avec", "dans", "pour", "recette", "cuisiner"],
      "es": ["qué", "cómo", "donde", "cuándo", "mucho", "hola", "buenos", "días", "gracias", "por qué", "estás", "haciendo", "quiero", "puedes", "decirme", "ingredientes", "receta"],
      "de": ["wie", "was", "wo", "wann", "warum", "wer", "ich", "du", "wir", "ihr", "und", "aber", "mit", "für", "danke", "bitte", "hallo", "ist", "sind", "nicht", "rezept", "zutaten"],
      "ja": ["watashi", "anata", "boku", "kimi", "to", "deeto", "ikanai", "iku", "suki", "daijoubu", "nani", "doushite", "ohayo", "konnichiwa", "arigatou", "tabetai", "nomitai"],
      "ko": ["gomawo", "gamsahamnida", "kamsahamnida", "annyeong", "saranghae", "oppa", "noona", "mianhae", "jinjja", "daebak", "jebal", "chinggu", "yeobo", "bibimbap", "kimchi", "soju", "unni", "hyung"]
    },
    "multilingual_task_terms": {
      "cooking": [
        "recette", "ingrédient", "ingrédients", "cuisiner", "cuisson", "four", "farine", "levure", "sauce", "fromage", "pâte", "manger", "nourriture", "repas", "plat", "pizza",
        "receta", "ingredientes", "cocinar", "horno", "harina", "queso", "comida",
        "rezept", "zutaten", "kochen", "essen", "mehl", "käse", "gericht"
      ]
    },
    "nllb_model": {
      "model_id": "facebook/nllb-200-distilled-600M",
      "local_converted_path": "models/nlp/nllb-200-distilled-600M-ct2",
      "device": "hybrid",
      "cpu_compute_type": "int8",
      "cuda_compute_type": "int8_float16",
      "compute_type": "int8",
      "inter_threads": 4,
      "intra_threads": 4,
      "beam_size": 2,
      "max_input_tokens": 256,
      "adaptive_load_switching": {
        "enabled": true,
        "min_free_vram_mb": 1200,
        "max_gpu_utilization_percent": 85,
        "max_cpu_load_percent": 75,
        "check_interval_seconds": 3.0
      },
      "nllb_lang_map": {
        "en": "eng_Latn",
        "hi": "hin_Deva",
        "or": "ory_Orya",
        "bn": "ben_Beng",
        "ja": "jpn_Jpan",
        "zh": "zho_Hans",
        "fr": "fra_Latn",
        "es": "spa_Latn",
        "de": "deu_Latn",
        "ru": "rus_Cyrl",
        "ko": "kor_Hang"
      }
    },
    "hybrid_translation": {
      "enabled": true,
      "confidence_threshold": 0.82,
      "qwen_review_on_low_confidence": true,
      "personality_preservation_pass": true,
      "complexity_rules": {
        "simple": "nllb",
        "normal": "nllb",
        "emotional": "nllb_then_qwen_validate",
        "technical": "qwen",
        "creative": "qwen",
        "code": "qwen"
      },
      "complexity_word_thresholds": {
        "simple": 5,
        "normal": 30,
        "emotional_keywords": ["lonely", "sad", "miss", "love", "heart", "hurt", "cry", "feel", "अकेला", "दुखी", "淋しい", "孤独"]
      }
    },
    "translation_cache": {
      "enabled": true,
      "max_entries": 500,
      "ttl_seconds": 3600
    },
    "language_profiles": {
      "en": {"tone": "warm_friendly", "formality": "casual", "writing_style": "conversational", "use_contractions": true},
      "hi": {"tone": "warm_respectful", "formality": "polite", "writing_style": "expressive", "use_contractions": false},
      "or": {"tone": "warm_respectful", "formality": "polite", "writing_style": "expressive", "use_contractions": false},
      "bn": {"tone": "warm_friendly", "formality": "polite", "writing_style": "poetic", "use_contractions": false},
      "ja": {"tone": "polite_warm", "formality": "keigo_casual", "writing_style": "concise", "use_contractions": false},
      "zh": {"tone": "warm_friendly", "formality": "casual", "writing_style": "concise", "use_contractions": false},
      "fr": {"tone": "warm_expressive", "formality": "casual", "writing_style": "conversational", "use_contractions": true},
      "es": {"tone": "expressive_warm", "formality": "casual", "writing_style": "conversational", "use_contractions": true},
      "de": {"tone": "direct_warm", "formality": "casual", "writing_style": "precise", "use_contractions": false},
      "ru": {"tone": "warm_expressive", "formality": "casual", "writing_style": "rich", "use_contractions": false},
      "ko": {"tone": "polite_warm", "formality": "informal_polite", "writing_style": "concise", "use_contractions": false}
    }
  },

  "action_system": {
    "_comment": "Voice Assistant Action System — Intent-Based Command Execution Configuration",
    "enabled": true,
    "local_first": true,
    "risk_confirmation_required": ["HIGH_RISK"],
    "max_retries": 3,
    "action_timeout_seconds": 30,
    "observation_wait_seconds": 2.0,
    "clarification_confidence_threshold": 0.55,

    "media_search_roots": [],
    "media_extensions": [".mp3", ".flac", ".wav", ".ogg", ".m4a", ".aac", ".wma",
                         ".mp4", ".mkv", ".avi", ".mov", ".wmv", ".webm"],
    "preferred_media_player": "",

    "browser_discovery_enabled": true,
    "preferred_browser": "",
    "browser_candidates": ["chrome", "firefox", "msedge", "brave", "opera"],

    "shopping_providers": [
      {"name": "flipkart",   "url": "https://www.flipkart.com/search?q={query}",            "region": "IN",     "enabled": true},
      {"name": "amazon_in",  "url": "https://www.amazon.in/s?k={query}",                   "region": "IN",     "enabled": true},
      {"name": "meesho",     "url": "https://www.meesho.com/search?q={query}",              "region": "IN",     "enabled": true},
      {"name": "snapdeal",   "url": "https://www.snapdeal.com/search?keyword={query}",      "region": "IN",     "enabled": true},
      {"name": "myntra",     "url": "https://www.myntra.com/{query}",                       "region": "IN",     "enabled": true},
      {"name": "amazon",     "url": "https://www.amazon.com/s?k={query}",                   "region": "global", "enabled": true},
      {"name": "ebay",       "url": "https://www.ebay.com/sch/i.html?_nkw={query}",         "region": "global", "enabled": true}
    ],
    "shopping_provider_rotation": "random",

    "app_discovery_cache_ttl_seconds": 300,
    "known_apps": {},

    "telemetry_events": true,

    "action_risk_classes": {
      "LOW_RISK":    ["browsing", "searching", "opening", "reading", "filtering", "find", "list"],
      "MEDIUM_RISK": ["downloading", "modifying_files", "changing_settings", "sending_messages"],
      "HIGH_RISK":   ["deleting", "purchasing", "financial_transactions", "account_changes", "irreversible"]
    }
  }
}
